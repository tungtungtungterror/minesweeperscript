local function Stepper(text, order, min, max, step, initial, onChange)
	local row = Row(text, order, false)
	local holder = new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.new(0, 88, 1, 0),
		BackgroundTransparency = 1,
		Parent = row,
	})
	local value = initial
	local label = new("TextLabel", {
		Size = UDim2.new(1, -56, 1, 0),
		Position = UDim2.fromOffset(28, 0),
		BackgroundTransparency = 1,
		Font = FONT,
		TextSize = 13,
		TextColor3 = C.gold,
		Text = tostring(value),
		Parent = holder,
	})
	local function arrow(glyph, onRight, delta)
		local b = new("TextButton", {
			Size = UDim2.new(0, 28, 1, 0),
			Position = onRight and UDim2.new(1, -28, 0, 0) or UDim2.new(0, 0, 0, 0),
			BackgroundTransparency = 1,
			Font = FONT,
			TextSize = 13,
			TextColor3 = C.dim,
			Text = glyph,
			AutoButtonColor = false,
			Parent = holder,
		})
		hover(b)
		b.Activated:Connect(function()
			local v = math.clamp(value + delta, min, max)
			if v ~= value then
				value = v
				label.Text = tostring(v)
				onChange(v)
			end
		end)
	end
	arrow("<", false, -step)
	arrow(">", true, step)
end

