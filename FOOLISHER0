local function ResetBoard()
	for _, c in ipairs(Memory.Links) do c:Disconnect() end
	Memory.Links = {}
	for _, unit in ipairs(Memory.Units) do
		if unit.dummy then unit.dummy:Destroy() end
	end
	Memory.Folder = nil
	Memory.DirtyUnits = {}
	Memory.Grid, Memory.Units = {}, {}
	Memory.NumberSet, Memory.Numbers = {}, {}
	Memory.Mine, Memory.Safe = {}, {}
	Stats.mines, Stats.safe, Stats.ms = 0, 0, nil
end

local function MinStep(values)
	table.sort(values)
	local step = math.huge
	for i = 2, #values do
		local d = values[i] - values[i - 1]
		if d > 0.1 and d < step then step = d end
	end
	return step
end

local function BuildGrid(folder)
	ResetBoard()
	Memory.Folder = folder
	Memory.Rebuild = false

	local function markRebuild() Memory.Rebuild = true end
	Link(folder.ChildAdded, markRebuild)
	Link(folder.ChildRemoved, markRebuild)

	local parts, xs, zs = {}, {}, {}
	for _, p in ipairs(folder:GetChildren()) do
		if p:IsA("BasePart") then
			local old = p:FindFirstChild("SolverVisual")
			if old then old:Destroy() end
			table.insert(parts, p)
			table.insert(xs, p.Position.X)
			table.insert(zs, p.Position.Z)
		end
	end
	if #parts == 0 then return end

	local stepX, stepZ = MinStep(xs), MinStep(zs)
	local minX, minZ = xs[1], zs[1]

	local sizeX, sizeZ = 0, 0
	local placement = {}
	for _, p in ipairs(parts) do
		local ix = math.floor((p.Position.X - minX) / stepX + 0.5)
		local iz = math.floor((p.Position.Z - minZ) / stepZ + 0.5)
		placement[p] = { ix, iz }
		sizeX = math.max(sizeX, ix + 1)
		sizeZ = math.max(sizeZ, iz + 1)
	end

	for x = 0, sizeX - 1 do
		Memory.Grid[x] = {}
		for z = 0, sizeZ - 1 do
			local unit = { ix = x, iz = z, adj = {}, hidden = false, mode = "none" }
			Memory.Grid[x][z] = unit
			table.insert(Memory.Units, unit)
		end
	end

	for p, pos in pairs(placement) do
		local unit = Memory.Grid[pos[1]][pos[2]]
		unit.part = p
		Memory.DirtyUnits[unit] = true

		local function onChild(child)
			if child.Name ~= "SolverVisual" then
				Memory.DirtyUnits[unit] = true
			end
		end
		Link(p.ChildAdded, onChild)
		Link(p.ChildRemoved, onChild)
	end

	for _, unit in ipairs(Memory.Units) do
		for ox = -1, 1 do
			for oz = -1, 1 do
				if ox ~= 0 or oz ~= 0 then
					local n = At(unit.ix + ox, unit.iz + oz)
					if n then table.insert(unit.adj, n) end
				end
			end
		end
	end
end

local function WatchNumberGui(unit, gui, label)
	local function markDirty() Memory.DirtyUnits[unit] = true end
	if unit.watchedGui ~= gui then
		unit.watchedGui = gui
		Link(gui.DescendantAdded, markDirty)
	end
	if label and unit.watchedLabel ~= label then
		unit.watchedLabel = label
		Link(label:GetPropertyChangedSignal("Text"), markDirty)
	end
end

local function ScanUnit(unit)
	local p = unit.part
	local state, val, hidden = nil, nil, false

	local gui = p:FindFirstChild("NumberGui") or p:FindFirstChild("numbergui")
	if gui then
		local label = gui:FindFirstChildWhichIsA("TextLabel", true)
		WatchNumberGui(unit, gui, label)
		val = label and tonumber(label.Text)
		state = val or "R"
	elseif looksHidden(p) then
		hidden = true
		state = "H"
	else
		state = "R"
	end

	unit.hidden, unit.val = hidden, val
	Memory.NumberSet[unit] = val and true or nil

	local changed = state ~= unit.state
	unit.state = state
	return changed
end

--------------------------------------------------------------------
-- SOLVER
--------------------------------------------------------------------
local function BuildConstraints(mine, safe)
	local list, cellCons = {}, {}
	for _, unit in ipairs(Memory.Numbers) do
		local cells, known = {}, 0
		for _, n in ipairs(unit.adj) do
			if n.hidden then
				if mine[n] then
					known += 1
				elseif not safe[n] then
					table.insert(cells, n)
				end
			end
		end
		local need = unit.val - known
		if #cells > 0 and need >= 0 and need <= #cells then
			local c = { need = need, cells = cells, set = {} }
			for _, u in ipairs(cells) do
				c.set[u] = true
				local t = cellCons[u]
				if not t then
					t = {}
					cellCons[u] = t
				end
				table.insert(t, c)
			end
			table.insert(list, c)
		end
	end
	return list, cellCons
end

local function GlobalPass(mine, safe)
	if not Prefs.TotalMines then return false end
	local known, unknown = 0, {}
	for _, unit in ipairs(Memory.Units) do
		if unit.hidden then
			if mine[unit] then
				known += 1
			elseif not safe[unit] then
				table.insert(unknown, unit)
			end
		end
	end
	local left = Prefs.TotalMines - known
	if #unknown == 0 then return false end
	if left == 0 then
		for _, u in ipairs(unknown) do safe[u] = true end
		return true
	elseif left == #unknown then
		for _, u in ipairs(unknown) do mine[u] = true end
		return true
	end
	return false
end

local function BasicPass(list, mine, safe)
	local changed = false
	for _, c in ipairs(list) do
		if c.need == 0 then
			for _, u in ipairs(c.cells) do safe[u] = true end
			changed = true
		elseif c.need == #c.cells then
			for _, u in ipairs(c.cells) do mine[u] = true end
			changed = true
		end
	end
	return changed
end

local function SubsetPass(list, cellCons, mine, safe)
	local changed = false
	for _, a in ipairs(list) do
		local checked = {}
		for _, u in ipairs(a.cells) do
			for _, b in ipairs(cellCons[u]) do
				if b ~= a and not checked[b] then
					checked[b] = true

					local shared = 0
					for _, v in ipairs(b.cells) do
						if a.set[v] then shared += 1 end
					end
					local bOnly = #b.cells - shared

					if bOnly > 0 then
						local aOnly = #a.cells - shared
						local maxShared = math.min(a.need, shared)
						local minShared = math.max(0, a.need - aOnly)
						local allMines = (b.need - maxShared == bOnly)
						local allSafe = (b.need == minShared)

						if allMines or allSafe then
							for _, v in ipairs(b.cells) do
								if not a.set[v] then
									if allMines then mine[v] = true else safe[v] = true end
								end
							end
							changed = true
						end
					end
				end
			end
		end
	end
	return changed
end

local function SolveCluster(cluster, cellCons, mine, safe)
	local assign, counts, solutions = {}, {}, 0
	for _, u in ipairs(cluster) do counts[u] = 0 end

	local function valid(u)
		for _, c in ipairs(cellCons[u]) do
			local m, open = 0, 0
			for _, v in ipairs(c.cells) do
				local a = assign[v]
				if a == 1 then
					m += 1
				elseif a == nil then
					open += 1
				end
			end
			if m > c.need or m + open < c.need then return false end
		end
		return true
	end

	local function search(i)
		if i > #cluster then
			solutions += 1
			for _, u in ipairs(cluster) do
				if assign[u] == 1 then counts[u] += 1 end
			end
			return
		end
		local u = cluster[i]
		assign[u] = 0
		if valid(u) then search(i + 1) end
		assign[u] = 1
		if valid(u) then search(i + 1) end
		assign[u] = nil
	end

	search(1)
	if solutions == 0 then return false end

	local changed = false
	for _, u in ipairs(cluster) do
		if counts[u] == solutions then
			mine[u] = true
			changed = true
		elseif counts[u] == 0 then
			safe[u] = true
			changed = true
		end
	end
	return changed
end

local function EnumeratePass(list, cellCons, mine, safe)
	local seen, changed = {}, false
	for _, c0 in ipairs(list) do
		local start = c0.cells[1]
		if not seen[start] then
			local cluster, consSeen = {}, {}
			local stack = { start }
			seen[start] = true
			while #stack > 0 do
				local u = table.remove(stack)
				table.insert(cluster, u)
				for _, c in ipairs(cellCons[u]) do
					if not consSeen[c] then
						consSeen[c] = true
						for _, v in ipairs(c.cells) do
							if not seen[v] then
								seen[v] = true
								table.insert(stack, v)
							end
						end
					end
				end
			end

			if #cluster <= Prefs.MaxCluster and SolveCluster(cluster, cellCons, mine, safe) then
				changed = true
			end
		end
	end
	return changed
end

local function Compute()
	local numbers = {}
	for unit in pairs(Memory.NumberSet) do table.insert(numbers, unit) end
	Memory.Numbers = numbers

	local mine, safe = {}, {}
	while true do
		local list, cellCons = BuildConstraints(mine, safe)
		local progressed = GlobalPass(mine, safe)
			or BasicPass(list, mine, safe)
			or SubsetPass(list, cellCons, mine, safe)
			or EnumeratePass(list, cellCons, mine, safe)
		if not progressed then break end
	end

	local m, s = 0, 0
	for _ in pairs(mine) do m += 1 end
	for _ in pairs(safe) do s += 1 end
	Stats.mines, Stats.safe = m, s
	Memory.Mine, Memory.Safe = mine, safe
end

local function RunSolve()
	local t = os.clock()
	Compute()
	Stats.ms = (os.clock() - t) * 1000
	Draw()
	UpdateStats()
end

local function Resolve()
	if Prefs.Active and #Memory.Units > 0 then RunSolve() end
end

local function SetActive(on)
	Prefs.Active = on
	if on then
		Memory.Rebuild = true
	else
		HideAll()
	end
	UpdateStats()
end

