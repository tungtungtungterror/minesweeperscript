-- VISUALS
--------------------------------------------------------------------
local function EnsureEdges(unit)
	if unit.edges then return end
	local part = unit.part

	local dummy = Instance.new("Part")
	dummy.Name = "SolverVisual"
	dummy.Size = part.Size - Vector3.new(Visuals.SHRINK_AMOUNT, 0.05, Visuals.SHRINK_AMOUNT)
	dummy.CFrame = part.CFrame
	dummy.Anchored = false
	dummy.CanCollide = false
	dummy.CanQuery = false
	dummy.CanTouch = false
	dummy.CastShadow = false
	dummy.Transparency = 1
	dummy.Massless = true

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = dummy
	weld.Part1 = part
	weld.Parent = dummy

	local edges = {}
	local sx, sy, sz = dummy.Size.X, dummy.Size.Y, dummy.Size.Z
	local r = Visuals.LINE_THICKNESS / 2
	local lenX, lenZ = sx + Visuals.SHRINK_AMOUNT, sz + Visuals.SHRINK_AMOUNT

	local function makeEdge(name, cf, h)
		local cyl = Instance.new("CylinderHandleAdornment")
		cyl.Name = name
		cyl.Adornee = dummy
		cyl.Radius = r
		cyl.Height = h
		cyl.CFrame = cf
		cyl.Transparency = 1
		cyl.ZIndex = 5
		cyl.AlwaysOnTop = true
		cyl.Parent = dummy
		edges[name] = cyl
	end

	makeEdge("TR", CFrame.new(sx / 2, sy / 2, 0), lenZ)
	makeEdge("TL", CFrame.new(-sx / 2, sy / 2, 0), lenZ)
	makeEdge("TF", CFrame.new(0, sy / 2, sz / 2) * CFrame.Angles(0, math.pi / 2, 0), lenX)
	makeEdge("TB", CFrame.new(0, sy / 2, -sz / 2) * CFrame.Angles(0, math.pi / 2, 0), lenX)

	dummy.Parent = part

	unit.dummy = dummy
	unit.edges = edges
	unit.shown = {}
end

local function UpdateEdges(unit)
	local mode = unit.mode
	local x, z = unit.ix, unit.iz
	for name, edge in pairs(unit.edges) do
		local o = EDGE_OFFSETS[name]
		local n = At(x + o[1], z + o[2])
		local want = nil
		if mode ~= "none" and not (n and n.mode == mode) then
			want = mode
		end
		if unit.shown[name] ~= want then
			unit.shown[name] = want
			if want then
				edge.Color3 = (want == "mine") and Visuals.M_COL or Visuals.S_COL
				edge.Transparency = 0
			else
				edge.Transparency = 1
			end
		end
	end
end

local function Draw()
	for _, unit in ipairs(Memory.Units) do
		local mode = "none"
		if unit.part and unit.hidden then
			if Memory.Mine[unit] then
				mode = "mine"
			elseif Memory.Safe[unit] then
				mode = "safe"
			end
		end
		unit.mode = mode
		if mode ~= "none" then EnsureEdges(unit) end
	end
	for _, unit in ipairs(Memory.Units) do
		if unit.edges then UpdateEdges(unit) end
	end
end

local function HideAll()
	for _, unit in ipairs(Memory.Units) do
		unit.mode = "none"
		if unit.edges then UpdateEdges(unit) end
	end
end

