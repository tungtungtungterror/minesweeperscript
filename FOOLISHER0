-- MAIN LOOP
--------------------------------------------------------------------
table.insert(Running, _RS.Heartbeat:Connect(function()
	if not Prefs.Active then return end

	local flag = _W:FindFirstChild("Flag")
	local folder = flag and flag:FindFirstChild("Parts")
	if not folder then
		if Memory.Folder then
			ResetBoard()
			UpdateStats()
		end
		return
	end

	if folder ~= Memory.Folder or Memory.Rebuild then
		BuildGrid(folder)
		UpdateStats()
	end

	if next(Memory.DirtyUnits) == nil then return end

	local dirty = Memory.DirtyUnits
	Memory.DirtyUnits = {}
	local changed = false

	for unit in pairs(dirty) do
		if unit.part.Parent ~= folder then
			Memory.Rebuild = true
			return
		end
		if ScanUnit(unit) then changed = true end
	end

	if changed then RunSolve() end
end))

_G.__SweeperCleanup = function()
	for _, c in ipairs(Running) do c:Disconnect() end
	ResetBoard()
	gui:Destroy()
	watermarkGui:Destroy()
end
