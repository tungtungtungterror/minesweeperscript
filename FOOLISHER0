local EDGE_OFFSETS = {
	TR = { 1, 0 },
	TL = { -1, 0 },
	TF = { 0, 1 },
	TB = { 0, -1 },
}

-- Hidden tiles are green; revealed tiles change color.
local function looksHidden(part)
	if part.Transparency >= 0.5 then return false end
	local c = part.Color
	return c.G > c.R and c.G > c.B
end

local function At(x, z)
	local col = Memory.Grid[x]
	return col and col[z]
end

local function Link(signal, fn)
	table.insert(Memory.Links, signal:Connect(fn))
end

