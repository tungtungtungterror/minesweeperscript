				BackgroundColor3 = colors[ICON[row][col]],
				BorderSizePixel = 0,
				Parent = parent,
			})
		end
	end
end

-- Drag by mouse or finger. Tracks one specific touch so the thumbstick finger can't grab it.
-- A press that doesn't move counts as a tap.
local function makeDraggable(handle, target, onTap)
	local active, startInput, startPos, moved = nil, nil, nil, false

	handle.InputBegan:Connect(function(input)
		local t = input.UserInputType
		if active or (t ~= Enum.UserInputType.MouseButton1 and t ~= Enum.UserInputType.Touch) then
			return
		end
		active = input
		startInput = input.Position
		startPos = target.Position
		moved = false
	end)

	table.insert(Running, _UIS.InputChanged:Connect(function(input)
		if not active then return end
		local isTouch = active.UserInputType == Enum.UserInputType.Touch
		if isTouch and input ~= active then return end
		if not isTouch and input.UserInputType ~= Enum.UserInputType.MouseMovement then return end

		local d = input.Position - startInput
		if not moved and d.Magnitude < 6 then return end
		moved = true
		target.Position = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + d.X,
			startPos.Y.Scale, startPos.Y.Offset + d.Y
		)
	end))

	table.insert(Running, _UIS.InputEnded:Connect(function(input)
		if not active then return end
		local isTouch = active.UserInputType == Enum.UserInputType.Touch
		if (isTouch and input == active)
			or (not isTouch and input.UserInputType == Enum.UserInputType.MouseButton1) then
			if not moved and onTap then onTap() end
			active = nil
		end
	end))
end

